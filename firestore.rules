rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // User document itself
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Settings: only the owner can read/write
      match /settings/{settingDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sets (workout data): owner only, with data validation on create
      match /sets/{setDoc} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.exercise is string
          && request.resource.data.weight is number
          && request.resource.data.reps is number
          && request.resource.data.timestamp is int;

        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
